{
  "name": "@swayamkothari345/codepulse",
  "version": "0.1.0",
  "description": "Intelligent JavaScript code health analyzer — find complexity, duplication, and code smells",
  "type": "module",
  "bin": {
    "codepulse": "./bin/codepulse.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests bin",
    "lint:fix": "eslint src tests bin --fix",
    "analyze:self": "node bin/codepulse.js analyze ."
  },
  "keywords": [
    "static-analysis",
    "code-quality",
    "complexity",
    "duplication",
    "javascript",
    "cli",
    "linter",
    "code-health",
    "maintainability"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.0",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.56.0",
    "vitest": "^1.0.0"
  }
}
